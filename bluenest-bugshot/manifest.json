{
  "manifest_version": 3,
  "name": "Bluenest Bugshot",
  "version": "1.3.0",
  "description": "Select a region of a page, annotate it, and send it to a Notion database as a QA card.",
  "action": {
    "default_title": "Capture QA screenshot"
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "commands": {
    "capture-region": {
      "suggested_key": {
        "default": "Ctrl+Shift+U",
        "mac": "Command+Shift+U"
      },
      "description": "Capture and annotate a region to send to Notion"
    },
    "capture-visible": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Capture the visible area and annotate it"
    },
    "capture-fullpage": {
      "suggested_key": {
        "default": "Ctrl+Shift+F",
        "mac": "Command+Shift+F"
      },
      "description": "Capture the full page (scrolling) and annotate it"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "permissions": ["activeTab", "storage", "scripting", "notifications", "contextMenus"],
  "host_permissions": ["https://api.notion.com/*"],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
